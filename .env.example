# Copy to .env. All values are optional; defaults shown.
POSTGRES_USER=dll
POSTGRES_PASSWORD=dll
POSTGRES_DB=dll

# Backend (also honoured when running without Docker)
# DLL_DATA_DIR=./data                      # raw/ (downloads), cache/, runs/
# DLL_DATABASE_URL=sqlite:///./data/runs/dll.sqlite3
DLL_SEED=42
DLL_BRAIN_PRESET=al_std                    # al_std | exact  (see RESEARCH.md §4)
DLL_BRAIN_ENGINE=numba                     # numba | numpy (reference, ~17x slower)
DLL_LOG_LEVEL=INFO
# DLL_CORS_ORIGINS=http://localhost:5173

# Frontend dev server proxy target
# VITE_BACKEND_URL=http://localhost:8000
